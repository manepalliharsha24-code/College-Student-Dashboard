
/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6fb;
    color: #252b42;
}

/* Dashboard Layout */
.dashboard {
    display: flex;
    min-height: 100vh;
}

/* Sidebar */
.sidebar {
    width: 250px;
    background: #171d35;
    color: white;
    padding: 30px 20px;
    position: fixed;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

.logo {
    font-size: 30px;
    margin-bottom: 5px;
}

.logo span {
    color: #8b7bff;
}

.portal {
    font-size: 11px;
    color: #929bb8;
    letter-spacing: 2px;
    margin-bottom: 35px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sidebar nav a,
.sidebar-bottom a {
    text-decoration: none;
    color: #c4cbe0;
    padding: 13px;
    border-radius: 8px;
    transition: 0.3s;
}

.sidebar nav a:hover,
.sidebar nav a.active,
.sidebar-bottom a:hover {
    background: #343d65;
    color: white;
}

.sidebar-bottom {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    gap: 8px;
}

/* Main Content */
.main-content {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 30px;
}

/* Topbar */
.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.topbar h2 {
    font-size: 24px;
}

.topbar p {
    color: #81889e;
    font-size: 14px;
}

.student {
    display: flex;
    align-items: center;
    gap: 12px;
}

.student h4 {
    font-size: 15px;
}

.student small {
    color: #81889e;
}

.notification {
    font-size: 22px;
    margin-right: 10px;
}

.avatar {
    background: linear-gradient(135deg, #7665f5, #a78bfa);
    color: white;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: bold;
}

/* Welcome Section */
.welcome {
    background: linear-gradient(120deg, #5146c7, #8575f5);
    color: white;
    padding: 35px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.welcome p:first-child {
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.welcome h1 {
    font-size: 30px;
    margin-bottom: 10px;
}

.welcome h3 {
    margin-bottom: 8px;
}

.welcome-icon {
    font-size: 80px;
}

/* Summary Cards */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 35px;
}

.stat-card {
    padding: 25px;
    border-radius: 14px;
    background: white;
    box-shadow: 0 4px 15px #1d294010;
    transition: 0.3s;
}

.stat-card:hover {
    transform: translateY(-6px);
}

.stat-icon {
    font-size: 27px;
    margin-bottom: 15px;
}

.stat-card p {
    color: #7c8499;
    font-size: 14px;
}

.stat-card h2 {
    font-size: 30px;
    margin: 8px 0;
}

.stat-card small {
    color: #81889e;
}

.blue h2 {
    color: #377be8;
}

.purple h2 {
    color: #8064e8;
}

.orange h2 {
    color: #ef963f;
}

.green h2 {
    color: #25a979;
}

/* Sections */
.content-section {
    margin-bottom: 35px;
    scroll-margin-top: 20px;
}

.section-heading {
    font-size: 22px;
    margin-bottom: 18px;
}

.panel {
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 4px 15px #1d294010;
}

/* Attendance */
.attendance-item {
    margin-bottom: 22px;
}

.subject {
    display: flex;
    justify-content: space-between;
    margin-bottom: 9px;
}

.subject b {
    color: #6555dc;
}

.progress {
    height: 9px;
    background: #e9ebf3;
    border-radius: 10px;
    overflow: hidden;
}

.progress div {
    height: 100%;
    background: linear-gradient(90deg, #6255df, #a58bff);
    border-radius: 10px;
}

/* Timetable */
.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th, td {
    padding: 16px;
    text-align: center;
    border-bottom: 1px solid #edf0f5;
    font-size: 14px;
}

th {
    background: #f0efff;
    color: #5545c8;
}

td {
    color: #626a80;
}

/* Assignments */
.assignment {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid #edf0f5;
    gap: 15px;
}

.assignment:last-child {
    border-bottom: none;
}

.assignment h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.assignment p,
.assignment small {
    color: #858ca0;
    font-size: 13px;
}

.status {
    padding: 7px 13px;
    border-radius: 20px;
    font-size: 12px;
    white-space: nowrap;
}

.pending {
    background: #fff0d9;
    color: #d58a21;
}

.submitted {
    background: #dff8ec;
    color: #229b6a;
}

/* Exams */
.exam-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.exam-card {
    padding: 25px;
    background: white;
    border-radius: 14px;
    border-left: 5px solid #7665e8;
    box-shadow: 0 4px 15px #1d294010;
}

.exam-card span {
    color: #7665e8;
    font-size: 12px;
    font-weight: bold;
}

.exam-card h3 {
    margin: 12px 0;
}

.exam-card p,
.exam-card small {
    color: #7c8499;
}

/* Results */
.result-item {
    display: flex;
    justify-content: space-between;
    padding: 17px 0;
    border-bottom: 1px solid #edf0f5;
}

.result-item:last-child {
    border-bottom: none;
}

.result-item b {
    color: #6555dc;
}

/* Announcements */
.announcement {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 18px 0;
    border-bottom: 1px solid #edf0f5;
}

.announcement:last-child {
    border-bottom: none;
}

.announcement > span {
    font-size: 25px;
}

.announcement h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.announcement p,
.announcement small {
    color: #858ca0;
    font-size: 13px;
}

/* Profile */
.profile-panel {
    display: flex;
    align-items: center;
    gap: 25px;
}

.avatar.large {
    width: 85px;
    height: 85px;
    font-size: 35px;
}

.profile-panel p {
    color: #7c8499;
    margin-top: 7px;
}

/* Footer */
footer {
    text-align: center;
    color: #858ca0;
    padding: 30px 10px;
    font-size: 13px;
}

/* Responsive Design */
@media (max-width: 1100px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        width: 210px;
    }

    .main-content {
        margin-left: 210px;
        width: calc(100% - 210px);
    }
}

@media (max-width: 750px) {
    .dashboard {
        flex-direction: column;
    }

    .sidebar {
        position: relative;
        width: 100%;
        height: auto;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar-bottom {
        margin-top: 15px;
    }

    .main-content {
        margin-left: 0;
        width: 100%;
        padding: 20px;
    }

    .welcome h1 {
        font-size: 23px;
    }

    .welcome-icon {
        font-size: 45px;
    }
}

@media (max-width: 500px) {
    .topbar {
        align-items: flex-start;
        gap: 15px;
        flex-direction: column;
    }

    .stats,
    .exam-container {
        grid-template-columns: 1fr;
    }

    .welcome {
        padding: 22px;
    }

    .welcome-icon {
        display: none;
    }

    .assignment {
        align-items: flex-start;
        flex-direction: column;
    }

    .profile-panel {
        flex-direction: column;
        align-items: flex-start;
    }
}
